# 宿主机对外端口（容器内部固定为 8080）
HOST_PORT=8080
# 显示城市（例如南宁、上海、苏州）
CITY_NAME=南宁
# UTC 整小时偏移，例如中国为 8
TIMEZONE_OFFSET=8

# OpenCode Go 订阅用量（可选）
# 在 OpenCode 控制台创建仅具备 usage read 权限的 service account key。
# 该密钥只保存在服务端，不要提交到 Git，也不要写进 Kindle 配置。
OPENCODE_GO_API_KEY=
# 轮询间隔（秒），默认 60；小于 60 会被忽略
OPENCODE_USAGE_INTERVAL=60

# 中文科技热榜（横屏首页右侧，可选）
# 默认 5 个源（每源 2 条）：solidot,sspai,ithome,geekpark,v2ex
# 也支持内置预设 v2ex-hot、ruanyifeng、leiphone，或 "名称=RSS地址" 自定义源，最多 5 个
NEWS_SOURCES=solidot,sspai,ithome,geekpark,v2ex
# 轮询间隔（秒），默认 1800（30 分钟）；小于 300 会被忽略
NEWS_REFRESH_INTERVAL=1800
