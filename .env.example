# 宿主机对外端口（容器内部固定为 8080）
HOST_PORT=8080
# 显示城市（例如南宁、上海、苏州）
CITY_NAME=南宁
# UTC 整小时偏移，例如中国为 8
TIMEZONE_OFFSET=8

# OpenCode Go 订阅用量（可选）
# 在 OpenCode 控制台创建仅具备 usage read 权限的 service account key。
# 该密钥只保存在服务端，不要提交到 Git，也不要写进 Kindle 配置。
OPENCODE_GO_API_KEY=
# 轮询间隔（秒），默认 300；小于 60 会被忽略
OPENCODE_USAGE_INTERVAL=300
